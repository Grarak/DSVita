float4 out gl_Position : POSITION;
float2 out screenPos : TEXCOORD0;
// blendTex texel coords (row = scanline) computed here so the fragment lookups stay
// non-dependent reads
float2 out bldCntAlphaYAddr : TEXCOORD1;
float2 out masterBrightAddr : TEXCOORD2;

void main(float2 position) {
    screenPos = float2(position.x * 0.5 + 0.5, 1.0 - position.y * 0.5 - 0.5);
    bldCntAlphaYAddr = float2(screenPos.y, 0.25);
    masterBrightAddr = float2(screenPos.y, 0.75);
    gl_Position = float4(position.xy, 0.0, 1.0);
}
