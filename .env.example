# DSVita development environment — copy this file to .env in the repo root and
# fill in your own paths. The scripts in tools/ source it automatically.
# For cargo builds, load it into your shell first:
#   set -a; . ./.env; set +a
# (or use direnv / your shell's dotenv mechanism)

# --- Compilation (Linux armhf target) ---
# armhf sysroot with libsdl2-dev installed (see README "Linux" for debootstrap setup).
# Also used by the tools/ scripts for qemu-arm -L and the sysroot's armhf binutils.
DSVITA_SYSROOT=$HOME/ubuntu-armhf
# llvm-18 library directory (bindgen needs 18; newer versions misparse class sizes).
LIBCLANG_PATH=/usr/lib/llvm-18/lib

# --- Local testing (qemu-arm on the dev machine) ---
# Rom directory: launch.sh opens the UI on it.
DSVITA_ROMS_DIR=$HOME/nds
# Rom booted directly by launch_hw.sh and trace.sh.
DSVITA_TEST_ROM=$HOME/nds/hello_world.nds
# X display for local SDL runs (default :0).
#DSVITA_DISPLAY=:0
# Set if your Xwayland needs an explicit auth file.
#DSVITA_XAUTHORITY=

# --- Remote ARM test box (e.g. a raspberry pi running the armhf binary natively) ---
# ssh destination, key-based auth (pi_run.sh / pi_shot.sh / pi_key.sh).
DSVITA_PI_HOST=user@192.168.0.2
# Deployed emulator binary path on the box. Keep box-side work under a ~/claude/dsvita working
# dir (roms live at ~/nds) so the home dir stays clean (default ~/claude/dsvita/dsvita).
#DSVITA_PI_BIN=~/claude/dsvita/dsvita
# Wayland session bits on the box (defaults: /run/user/1000, wayland-0).
#DSVITA_PI_RUNTIME_DIR=/run/user/1000
#DSVITA_PI_WAYLAND_DISPLAY=wayland-0
# wtype binary on the box for key injection (default: wtype from PATH).
#DSVITA_PI_WTYPE=wtype

# Android NDK root (sysroot + compiler-rt only; host clang-21 does the compiling)
ANDROID_NDK_HOME=$HOME/android/android-ndk-r27c
